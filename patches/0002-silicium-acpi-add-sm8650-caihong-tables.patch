diff --git a/Platforms/OnePlus/caihong/Sources/DSDT.dsl b/Platforms/OnePlus/caihong/Sources/DSDT.dsl
new file mode 100644
index 0000000..9203fe0
--- /dev/null
+++ b/Platforms/OnePlus/caihong/Sources/DSDT.dsl
@@ -0,0 +1,183 @@
+/*
+ * DSDT for OnePlus Pad Pro (caihong / OPD2404), Qualcomm SM8650 ("Cliffs")
+ *
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ *
+ * PROVENANCE OF EVERY ADDRESS IN THIS FILE
+ * ========================================
+ * All numeric values below were extracted from the device's own signed
+ * firmware images (dtbo.img index 7 = the active overlay, and the vendor DTB
+ * carried in vendor_boot.img).  The extraction is reproducible with
+ *   scripts/extract_dtb.py  and  scripts/extract_hw.py
+ * and is recorded in docs/hardware-sm8650.md.  Nothing here is guessed from a
+ * different SoC.
+ *
+ *   SoC identification
+ *     pinctrl@f000000   compatible = "qcom,cliffs-pinctrl"
+ *     mainline equivalent compatible = "qcom,sm8650-tlmm"
+ *     -> "Cliffs" is Qualcomm's codename for SM8650.  SM8550 ("Kailua") and
+ *        SM8750 ("Pakala") are DIFFERENT SoCs and their constants are not
+ *        reused except where explicitly noted.
+ *
+ *   GICv3       interrupt-controller@17100000  (GICD 0x10000, GICR 0x200000
+ *               @0x17180000, #interrupt-cells = 3)
+ *   Arch timer  arm,armv8-timer, clock-frequency = 19200000,
+ *               PPI 13/14 -> GSIV 29/30, hypervisor 11/12, virt 10? (sec below)
+ *   UFS         ufshc@1d84000   reg 0x1d84000+0x3000, 0x1d88000+0x8000,
+ *                               0x1d90000+0x9000, 0x1da5000+0x2000, 0x1da4000+0x10
+ *                               interrupts = <0 265 4>  -> GSIV 0x129
+ *   USB3        ssusb@a600000 / dwc3@a600000
+ *                               reg 0xa600000+0xd93c, interrupts <0 133 4>
+ *                               -> GSIV 0xA5
+ *   TLMM/GPIO   pinctrl@f000000 reg 0xf000000+0x1000000, irq <0 208 4>
+ *                               -> GSIV 0xF0
+ *   SPMI        qcom,spmi@c42d000 (pmic-arb) and qcom,spmi@c432000
+ *   Debug UART  qcom,qup_uart@a94000 (qcom,geni-debug-uart)
+ *                               reg 0xa94000+0x4000, irq <0 358 4> -> GSIV 0x186
+ *
+ * KNOWN GAPS (deliberately NOT invented)
+ *   - Display / Adreno GPU: no ACPI device is emitted.  The panel is
+ *     mdss_dsi_panel_csot_nt36532_2120_3000_dual_dsc_144hz_vid on
+ *     mdss_mdp@ae00000 / mdss_dsi_ctrl0@ae94000, but the Windows side needs a
+ *     WDDM miniport (KGSL/DPU successor) that does not exist publicly.  TODO.
+ *   - Touch / pen: Novatek NT36532 on an I2C bus; the exact bus instance and
+ *     I2C address are not yet resolved from the overlay.  TODO.
+ *   - Wi-Fi/BT, audio, battery/charger, thermal: TODO, need PMIC child
+ *     resolution from the dtbo overlay and board wiring.
+ *   - PMIC SPMI USIDs: the SPMI controller is declared, children are TODO.
+ */
+
+DefinitionBlock ("DSDT.aml", "DSDT", 2, "ONEPLS", "CAIHONG", 0x00000001)
+{
+    Scope (\_SB)
+    {
+        /* ------------------------------------------------------------------
+         * CPUs.  SM8650 is 8 cores in 3 clusters (1x X4 + 3x A720 + 2x A520
+         * is the shipping configuration; the DTB cpus{} node is the authority
+         * and is cross-checked by scripts/extract_hw.py).  _UID must match the
+         * MPIDR ordering used by EDK2's ArmPkg MP core, i.e. 0..7.
+         * ------------------------------------------------------------------ */
+        Device (CPU0) { Name (_HID, "ACPI0007") Name (_UID, 0) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU1) { Name (_HID, "ACPI0007") Name (_UID, 1) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU2) { Name (_HID, "ACPI0007") Name (_UID, 2) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU3) { Name (_HID, "ACPI0007") Name (_UID, 3) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU4) { Name (_HID, "ACPI0007") Name (_UID, 4) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU5) { Name (_HID, "ACPI0007") Name (_UID, 5) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU6) { Name (_HID, "ACPI0007") Name (_UID, 6) Method (_STA, 0) { Return (0x0F) } }
+        Device (CPU7) { Name (_HID, "ACPI0007") Name (_UID, 7) Method (_STA, 0) { Return (0x0F) } }
+
+        /* ------------------------------------------------------------------
+         * UFS host controller.  _HID QCOM24A5 is the HID the Qualcomm UFS
+         * Windows driver binds to (same HID used by every other Mu-Qcom
+         * platform).  Resource span 0x1D84000..0x1DA7000 is derived from the
+         * union of the DTB `reg` entries listed above (end = 0x1DA5000+0x2000).
+         * ------------------------------------------------------------------ */
+        Device (UFS0)
+        {
+            Name (_HID, "QCOM24A5")
+            Name (_UID, Zero)
+            Name (_CCA, Zero)
+
+            Method (_STA, 0) { Return (0x0F) }
+
+            Method (_CRS, 0)
+            {
+                Name (RBUF, ResourceTemplate ()
+                {
+                    Memory32Fixed (ReadWrite, 0x01D84000, 0x00023000)
+                    Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 0x00000129 }
+                })
+                Return (RBUF)
+            }
+
+            Device (DEV0)
+            {
+                Method (_ADR, 0) { Return (0x08) }
+                Method (_RMV, 0) { Return (Zero) }
+            }
+        }
+
+        /* ------------------------------------------------------------------
+         * USB3 DRD controller (ssusb@a600000, dwc3 child).  GSIV 0xA5 comes
+         * from the dwc3 interrupt <0 133 4> (32 + 133).
+         * Only the controller itself is described here; Type-C role switch,
+         * redriver and DisplayPort-altmode are TODO.
+         * ------------------------------------------------------------------ */
+        Device (USB0)
+        {
+            Name (_HID, "QCOM0C8B")
+            Name (_UID, Zero)
+            Name (_CCA, Zero)
+
+            Method (_STA, 0) { Return (0x0F) }
+
+            Method (_CRS, 0)
+            {
+                Name (RBUF, ResourceTemplate ()
+                {
+                    Memory32Fixed (ReadWrite, 0x0A600000, 0x00100000)
+                    Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 0x000000A5 }
+                })
+                Return (RBUF)
+            }
+        }
+
+        /* ------------------------------------------------------------------
+         * TLMM / pin controller.  The Windows pinctrl driver consumes
+         * QCOM0C0C + QCOMFFEB, identical to the other Mu-Qcom platforms.
+         * Base 0xF000000 length 0x1000000, GSIV 0xF0 (32 + 208).
+         * ------------------------------------------------------------------ */
+        Device (GIO0)
+        {
+            Name (_HID, "QCOM0C0C")
+            Name (_CID, "QCOMFFEB")
+            Name (_UID, Zero)
+
+            Method (_STA, 0) { Return (0x0F) }
+
+            Method (_CRS, 0)
+            {
+                Name (RBUF, ResourceTemplate ()
+                {
+                    Memory32Fixed (ReadWrite, 0x0F000000, 0x01000000)
+                    Interrupt (ResourceConsumer, Level, ActiveHigh, Shared) { 0x000000F0 }
+                })
+                Return (RBUF)
+            }
+        }
+
+        /* ------------------------------------------------------------------
+         * SPMI PMIC arbiter.  Two arbiter instances exist in the DTB
+         * (0xC42D000 primary, 0xC432000 secondary).  Only the primary is
+         * declared; PMIC child devices (PM8550 family) are TODO.
+         * ------------------------------------------------------------------ */
+        Device (SPMI)
+        {
+            Name (_HID, "QCOM0C0B")
+            Name (_CID, "PNP0CA2")
+            Name (_UID, Zero)
+
+            Method (_STA, 0) { Return (0x0F) }
+
+            Method (_CRS, 0)
+            {
+                Name (RBUF, ResourceTemplate ()
+                {
+                    Memory32Fixed (ReadWrite, 0x0C42D000, 0x00004000)
+                })
+                Return (RBUF)
+            }
+        }
+
+        /* ------------------------------------------------------------------
+         * The GENI debug UART (qcom,qup_uart@a94000, GSIV 0x186) is NOT
+         * declared here.  Its ACPI _HID could not be verified from any
+         * first-party source: the stock Qualcomm UEFI image in uefi.img
+         * contains no readable ACPI strings, and no Mu-Qcom platform
+         * describes a QUP UART.  Emitting a fabricated HID would be worse
+         * than omitting the device.  Early console therefore relies on DBG2
+         * alone (see acpi/caihong/DBG2.dsl).  See docs/hardware-matrix.md,
+         * row "debug UART".  TODO.
+         * ------------------------------------------------------------------ */
+    }
+}
