diff --git a/SoCs/Qualcomm/Cliffs/DSDT_minimal.asl b/SoCs/Qualcomm/Cliffs/DSDT_minimal.asl
new file mode 100644
index 0000000..798b36c
--- /dev/null
+++ b/SoCs/Qualcomm/Cliffs/DSDT_minimal.asl
@@ -0,0 +1,71 @@
+﻿DefinitionBlock ("DSDT_minimal.aml", "DSDT", 2, "ONEPLS", "SM8650 ", 3)
+{
+    /*
+     * Minimal DSDT: processors only.
+     *
+     * Used as a bring-up stepping stone and as a fallback if the full caihong
+     * DSDT (Silicium-ACPI/Platforms/OnePlus/caihong) is not yet wired in.
+     * 8 processors / 3 clusters, matching the SM8650 vendor DTB
+     * (qcom,cpuidle-domain cpu-map = 3 / 4 / 1).
+     *
+     * OEM ID is "ONEPLS" because ACPI allows at most 6 characters.
+     */
+    Scope (\_SB)
+    {
+        Device (CPU0)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 0)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU1)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 1)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU2)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 2)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU3)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 3)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU4)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 4)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU5)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 5)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU6)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 6)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+
+        Device (CPU7)
+        {
+            Name (_HID, "ACPI0007")
+            Name (_UID, 7)
+            Method (_STA, 0, NotSerialized) { Return (0x0F) }
+        }
+    }
+}
