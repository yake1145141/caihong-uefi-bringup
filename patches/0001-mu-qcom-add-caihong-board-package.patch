+//
+// Bring-up progress bar owned by the caihong port (caihong.dsc,
+// CAIHONG_BRINGUP_MARKERS).  Whatever N the panel shows is the last milestone
+// reached; see Silicon/Silicium/SiliciumPkg/PrePi/PrePi.c for the numbering.
+//
+#if defined (CAIHONG_BRINGUP_MARKERS) && CAIHONG_BRINGUP_MARKERS
+#define BRINGUP_STEP(n)                                                \
+  do {                                                                 \
+    volatile UINT32 *BringupFb_ = (volatile UINT32 *)0xD5100000ULL;     \
+    UINTN            BringupX_, BringupY_, BringupBand_, BringupIn_;    \
+    for (BringupY_ = 0; BringupY_ < 2120U; BringupY_++) {                \
+      BringupBand_ = BringupY_ / (2120U / 14U);                         \
+      BringupIn_   = BringupY_ % (2120U / 14U);                         \
+      for (BringupX_ = 0; BringupX_ < 3000U; BringupX_++) {              \
+        BringupFb_[BringupY_ * 3000U + BringupX_] =                      \
+          (((BringupBand_ < (UINTN)(n)) && (BringupIn_ >= 6U)))          \
+            ? 0xFFFFFFFFU : 0xFF000000U;                                 \
+      }                                                                 \
+    }                                                                   \
+  } while (0)
+#else
+#define BRINGUP_STEP(n)   do { } while (0)
+#endif
+
 EFI_STATUS
 EFIAPI
 PlatformPeim ()
 {
+#if defined (CAIHONG_BRINGUP_MARKERS) && CAIHONG_BRINGUP_MARKERS
+  //
+  // Step 4 = PlatformPeim entered AND PcdFvBaseAddress describes where
+  // BootShim actually placed the volume (0xA7000000).
+  //
+  // BuildFvHob() publishes an FV HOB at that address and BuildMemHobForFv()
+  // then allocates memory at each FV2 HOB's base, so a wrong PCD here points
+  // the firmware volume at the wrong physical memory.  A solid RED screen means
+  // the PCD is wrong -- an unmistakable "root cause found" signal.
+  //
+  if (PcdGet64 (PcdFvBaseAddress) == 0xA7000000ULL) {
+    BRINGUP_STEP (4);
+  } else {
+    volatile UINT32 *BringupFb_ = (volatile UINT32 *)0xD5100000ULL;
+    UINTN            BringupI_;
+    for (BringupI_ = 0; BringupI_ < (3000U * 2120U); BringupI_++) {
+      BringupFb_[BringupI_] = 0xFFFF0000U;   // solid red: PCD is WRONG
+    }
+  }
+#endif
+
   // Build FV HOB
   BuildFvHob (PcdGet64 (PcdFvBaseAddress), PcdGet32 (PcdFvSize));
+
+#if defined (CAIHONG_BRINGUP_MARKERS) && CAIHONG_BRINGUP_MARKERS
+  // Step 5: BuildFvHob returned.
+  BRINGUP_STEP (5);
+#endif
+
   BuildMemHobForFv (EFI_HOB_TYPE_FV2);
 
+#if defined (CAIHONG_BRINGUP_MARKERS) && CAIHONG_BRINGUP_MARKERS
+  // Step 6: memory allocation HOBs for the FV2 HOBs created.
+  BRINGUP_STEP (6);
+#endif
+
   // Build Platform HOBs
   BuildPlatformHobs ();
 
+#if defined (CAIHONG_BRINGUP_MARKERS) && CAIHONG_BRINGUP_MARKERS
+  // Step 7: BuildPlatformHobs (PlatformHobLib) returned.
+  BRINGUP_STEP (7);
+#endif
+
   return EFI_SUCCESS;
 }
