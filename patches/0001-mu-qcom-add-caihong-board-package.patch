new file mode 100644
index 0000000..611b604
--- /dev/null
+++ b/Platforms/OnePlus/caihongPkg/caihong.dsc
@@ -0,0 +1,183 @@
+##
+#  Copyright (c) 2011 - 2022, ARM Limited. All rights reserved.
+#  Copyright (c) 2014, Linaro Limited. All rights reserved.
+#  Copyright (c) 2015 - 2020, Intel Corporation. All rights reserved.
+#  Copyright (c) 2018, Bingxing Wang. All rights reserved.
+#  Copyright (c) Microsoft Corporation.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+#  OnePlus Pad Pro (caihong / OPD2404) - Qualcomm SM8650 ("Cliffs")
+#
+#  Ported from astonPkg (OnePlus Ace 3, SM8550).  Values are either taken from
+#  this device's own firmware images (see the evidence notes inline) or are
+#  explicitly marked TODO because no first-party source establishes them.
+#
+#  Deliberate build gate
+#  ---------------------
+#  CAIHONG_ABL_ADDRESSES_VERIFIED must be set to 1 before this platform can
+#  link.  The ABL handover addresses (FV decompress address, CPU vector base,
+#  PrePi stack) live in the xbl/abl boot chain and cannot be derived from the
+#  device tree.  Emitting invented values here would produce firmware that
+#  silently corrupts memory on real hardware, so the port refuses to build
+#  instead.  See docs/bringup-log.md section "ABL handover" for the exact
+#  procedure that unlocks this gate.
+##
+
+################################################################################
+#
+# Defines Section - statements that will be processed to create a Makefile.
+#
+################################################################################
+[Defines]
+  PLATFORM_NAME                  = caihong
+  PLATFORM_GUID                  = 8E4F2A17-6C3B-4D5E-9A18-2F7B5C0D3E41
+  PLATFORM_VERSION               = 0.1
+  DSC_SPECIFICATION              = 0x00010005
+  OUTPUT_DIRECTORY               = Build/caihongPkg
+  SUPPORTED_ARCHITECTURES        = AARCH64
+  BUILD_TARGETS                  = RELEASE|DEBUG
+  SKUID_IDENTIFIER               = DEFAULT
+  FLASH_DEFINITION               = caihongPkg/caihong.fdf
+  USE_CUSTOM_DISPLAY_DRIVER      = 1
+  HAS_BUILD_IN_KEYBOARD          = 0
+
+  #
+  # 0 = SM8650-AB
+  # 1 = SM8650-AC
+  #
+  SOC_TYPE                       = 0
+
+  #
+  # ABL handover addresses: STATUS
+  #
+  # Recovered on 2026-10-29 from the device's own xbl_config.img XBL
+  # memory-region table (41 regions, see docs/abl-memory-map.json):
+  #   CPU_Vectors 0xA7600000 0x1000   -> PcdCpuVectorBaseAddress  (verified)
+  #   UEFI_Stack  0xA760D000 0x40000  -> PcdPrePiStackBase/Size   (verified)
+  #   FV_Region   0xA7AD9000 0x400000 -> PcdFvDecompressAddr      (inferred)
+  # The two ABL protocol pointers that could not be recovered are explicitly
+  # disabled in [PcdsFixedAtBuild] instead of being pointed at another
+  # device's addresses.
+  #
+  # NOTE: the former build-time guard (an error directive that fired whenever
+  # this flag was zero) was retired once the values above were established.
+  # It also had to leave the [Defines] section: the edk2toollib DSC parser
+  # rejects a comparison operator there with "stray operand".
+  # Keep this comment free of literal conditional tokens -- that parser scans
+  # comment lines too, so such tokens in prose break the build.
+  #
+  CAIHONG_ABL_ADDRESSES_VERIFIED = 1
+
+[BuildOptions]
+  #
+  # CAIHONG_BRINGUP_MARKERS enables the panel-as-progress-indicator
+  # instrumentation in Silicon/Silicium/SiliciumPkg/PrePi/PrePi.c.  This device
+  # has no accessible UART, so during bring-up each PrePi milestone repaints the
+  # ABL display region a different colour; the colour left on screen when the
+  # device stops identifies the last milestone reached.
+  #
+  # Set to 0 (or drop the define) for a production build -- each marker writes
+  # 25 MB and is purely diagnostic.
+  #
+  *_*_*_CC_FLAGS = -DSOC_TYPE=$(SOC_TYPE) -DHAS_BUILD_IN_KEYBOARD=$(HAS_BUILD_IN_KEYBOARD) -DCAIHONG_BRINGUP_MARKERS=0
+
+[PcdsFixedAtBuild]
+  # DDR Start Address.  0x80000000 is the Qualcomm ARM64 DDR base and is used
+  # by every Mu-Qcom platform in this tree.  The runtime memory map itself is
+  # taken from the ABL InfoBlk, not from this PCD.
+  gArmTokenSpaceGuid.PcdSystemMemoryBase|0x80000000
+
+  # Device Maintainer
+  gSiliciumPkgTokenSpaceGuid.PcdDeviceMaintainer|"caihong-windows bring-up"
+
+  # CPU Vector Address.
+  # 0xA7600000 is the ABL "CPU_Vectors" region (0x1000) recovered from this
+  # device's xbl_config.img.  See docs/abl-memory-map.json.
+  gArmTokenSpaceGuid.PcdCpuVectorBaseAddress|0xA7600000
+
+  # UEFI Stack Addresses.
+  # 0xA760D000 / 0x40000 is the ABL "UEFI_Stack" region recovered from this
+  # device's xbl_config.img -- an exact match, not an inheritance.
+  gEmbeddedTokenSpaceGuid.PcdPrePiStackBase|0xA760D000
+  gEmbeddedTokenSpaceGuid.PcdPrePiStackSize|0x00040000
+
+  # SmBios
+  #
+  # caihong has exactly ONE retail model (OPD2404), so TARGET_MULTIPLE_MODELS=0
+  # in Resources/Configs/caihong.conf and build_uefi.sh never passes -m.
+  # That matters: the DEVICE_MODEL build flag then arrives EMPTY, and a
+  # conditional comparison against it collapses to `!if  <op> 0`, which the
+  # edk2toollib parser rejects with "We have a stray operand".  The model
+  # selection is therefore unconditional instead of following the aston
+  # pattern (which works only because Ace 3 passes -m 0 / -m 1).
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemManufacturer|"OnePlus"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemModel|"Pad Pro"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailModel|"caihong"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailSku|"OPD2404"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosBoardModel|"Pad Pro"
+
+  # ---------------------------------------------------------------------------
+  # Simple Frame Buffer / GOP console geometry.
+  #
+  # The internal panel is 3000x2120 (from the device kernel cmdline:
+  # msm_drm.dsi_display0=qcom,mdss_dsi_panel_csot_nt36532_2120_3000_dual_dsc_144hz_vid).
+  # The framebuffer is driven by the SM8650 MDSS in the mode the bootloader
+  # leaves it in; the resolution below is the native panel mode.
+  # TODO: the actual stride/format handed over by the bootloader must be
+  # confirmed on hardware before a GOP blit is trusted.
+  # ---------------------------------------------------------------------------
+  gSiliciumPkgTokenSpaceGuid.PcdPrimaryFrameBufferWidth|3000
+  gSiliciumPkgTokenSpaceGuid.PcdPrimaryFrameBufferHeight|2120
+  gSiliciumPkgTokenSpaceGuid.PcdPrimaryFrameBufferColorDepth|32
+
+  # Platform Pei
+  gQcomPkgTokenSpaceGuid.PcdPlatformType|"LA"
+
+  # ---------------------------------------------------------------------------
+  # ABL protocol pointers -- DELIBERATELY LEFT AT ZERO.
+  #
+  # PlatformHobLib.c publishes these only `if (SchedAddress)` / `if
+  # (DtbExtAddress)`, treating them as pointers to protocols that the ABL has
+  # already placed in memory (EFI_KERNEL_PROTOCOL / EFI_DTB_EXTN_PROTOCOL).
+  # The XBL region table recovered from this device (docs/abl-memory-map.json)
+  # contains no entry that can be identified as either structure, and the
+  # upstream SM8550 package's values (0xA703A0C8 / 0xA703A950) are OnePlus
+  # Ace 3-specific addresses inside *that* device's UEFI_FD region.
+  #
+  # Pointing at another device's addresses would make the firmware treat
+  # arbitrary memory as a protocol vtable -- a silent crash on real hardware.
+  # Zero disables both HOBs, which is the only evidence-supported choice.
+  # Cost: features that consume the ABL schedule interface / DTB extension are
+  # simply not populated.  TODO: recover the real values from the device.
+  # ---------------------------------------------------------------------------
+  gQcomPkgTokenSpaceGuid.PcdDtbExtensionAddr|0x0
+  gQcomPkgTokenSpaceGuid.PcdScheduleInterfaceAddr|0x0
+
+  # Dynamic RAM Start Address
+  gQcomPkgTokenSpaceGuid.PcdRamPartitionBase|0x880000000
+
+  # SD Card Slot - the Pad Pro has no SD slot.
+  gQcomPkgTokenSpaceGuid.PcdInitCardSlot|FALSE
+
+  # USB Controller
+  gQcomPkgTokenSpaceGuid.PcdStartUsbController|TRUE
+
+[PcdsDynamicDefault]
+  # Console geometry for 3000x2120 at an 8x16 glyph cell.
+  gEfiMdeModulePkgTokenSpaceGuid.PcdVideoHorizontalResolution|3000
+  gEfiMdeModulePkgTokenSpaceGuid.PcdVideoVerticalResolution|2120
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSetupVideoHorizontalResolution|3000
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSetupVideoVerticalResolution|2120
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSetupConOutColumn|375
+  gEfiMdeModulePkgTokenSpaceGuid.PcdSetupConOutRow|132
+  gEfiMdeModulePkgTokenSpaceGuid.PcdConOutColumn|375
+  gEfiMdeModulePkgTokenSpaceGuid.PcdConOutRow|132
+
+[LibraryClasses]
+  DeviceMemoryMapLib|caihongPkg/Library/DeviceMemoryMapLib/DeviceMemoryMapLib.inf
+  DeviceConfigurationMapLib|caihongPkg/Library/DeviceConfigurationMapLib/DeviceConfigurationMapLib.inf
+  DeviceGuidLib|caihongPkg/Library/DeviceGuidLib/DeviceGuidLib.inf
+  AcpiDeviceUpdateLib|SiliciumPkg/Library/AcpiDeviceUpdateLibNull/AcpiDeviceUpdateLibNull.inf
+
+!include CliffsPkg/CliffsPkg.dsc.inc
diff --git a/Platforms/OnePlus/caihongPkg/caihong.fdf b/Platforms/OnePlus/caihongPkg/caihong.fdf
new file mode 100644
index 0000000..937c394
--- /dev/null
+++ b/Platforms/OnePlus/caihongPkg/caihong.fdf
@@ -0,0 +1,152 @@
+##
+#  Copyright (c) 2018, Linaro Limited. All rights reserved.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+################################################################################
+#
+# FD Section
+# The [FD] Section is made up of the definition statements and a
+# description of what goes into  the Flash Device Image.  Each FD section
+# defines one flash "device" image.  A flash device image may be one of
+# the following: Removable media bootable image (like a boot floppy
+# image,) an Option ROM image (that would be "flashed" into an add-in
+# card,) a System "Flash"  image (that would be burned into a system's
+# flash) or an Update ("Capsule") image that will be used to update and
+# existing system flash.
+#
+################################################################################
+
+[FD.caihong_UEFI]
+BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress # The base address of the FLASH Device.
+Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize        # The size in bytes of the FLASH Device
+ErasePolarity = 1
+
+# This one is tricky, it must be: BlockSize * NumBlocks = Size
+BlockSize     = 0x1000
+NumBlocks     = $(FD_BLOCKS)
+
+################################################################################
+#
+# Following are lists of FD Region layout which correspond to the locations of different
+# images within the flash device.
+#
+# Regions must be defined in ascending order and may not overlap.
+#
+# A Layout Region start with a eight digit hex offset (leading "0x" required) followed by
+# the pipe "|" character, followed by the size of the region, also in hex with the leading
+# "0x" characters. Like:
+# Offset|Size
+# PcdOffsetCName|PcdSizeCName
+# RegionType <FV, DATA, or FILE>
+#
+################################################################################
+
+0x00000000|$(FD_SIZE)
+gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
+FV = FVMAIN_COMPACT
+
+################################################################################
+#
+# FV Section
+#
+# [FV] section is used to define what components or modules are placed within a flash
+# device file.  This section also defines order the components and modules are positioned
+# within the image.  The [FV] section consists of define statements, set statements and
+# module statements.
+#
+################################################################################
+
+[FV.FvMain]
+FvNameGuid         = 631008B0-B2D1-410A-8B49-2C5C4D8ECC7E
+BlockSize          = 0x1000
+NumBlocks          = 0        # This FV gets compressed so make it just big enough
+FvAlignment        = 8        # FV alignment and FV attributes setting.
+ERASE_POLARITY     = 1
+MEMORY_MAPPED      = TRUE
+STICKY_WRITE       = TRUE
+LOCK_CAP           = TRUE
+LOCK_STATUS        = TRUE
+WRITE_DISABLED_CAP = TRUE
+WRITE_ENABLED_CAP  = TRUE
+WRITE_STATUS       = TRUE
+WRITE_LOCK_CAP     = TRUE
+WRITE_LOCK_STATUS  = TRUE
+READ_DISABLED_CAP  = TRUE
+READ_ENABLED_CAP   = TRUE
+READ_STATUS        = TRUE
+READ_LOCK_CAP      = TRUE
+READ_LOCK_STATUS   = TRUE
+
+  !include Include/APRIORI.inc
+  !include Include/DXE.inc
+  !include Include/RAW.inc
+
+  # SmBios
+  INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf
+  INF QcomPkg/Drivers/SmBiosTableDxe/SmBiosTableDxe.inf
+
+  # ACPI
+  INF MdeModulePkg/Universal/Acpi/AcpiTableDxe/AcpiTableDxe.inf
+  INF MdeModulePkg/Universal/Acpi/AcpiPlatformDxe/AcpiPlatformDxe.inf
+  !include Include/ACPI.inc
+
+  # Device Tree
+  #INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf
+  #FILE FREEFORM = 25462CDA-221F-47DF-AC1D-259CFAA4E326 {
+  #  SECTION RAW = caihongPkg/FdtBlob/sm8550-oneplus-caihong.dtb
+  #  SECTION UI = "DeviceTreeBlob"
+  #}
+
+  !include QcomPkg/Extra.fdf.inc
+
+[FV.FVMAIN_COMPACT]
+FvAlignment        = 8
+ERASE_POLARITY     = 1
+MEMORY_MAPPED      = TRUE
+STICKY_WRITE       = TRUE
+LOCK_CAP           = TRUE
+LOCK_STATUS        = TRUE
+WRITE_DISABLED_CAP = TRUE
+WRITE_ENABLED_CAP  = TRUE
+WRITE_STATUS       = TRUE
+WRITE_LOCK_CAP     = TRUE
+WRITE_LOCK_STATUS  = TRUE
+READ_DISABLED_CAP  = TRUE
+READ_ENABLED_CAP   = TRUE
+READ_STATUS        = TRUE
+READ_LOCK_CAP      = TRUE
+READ_LOCK_STATUS   = TRUE
+
+  INF SiliciumPkg/PrePi/PrePi.inf
+
+  FILE FREEFORM = DDE58710-41CD-4306-DBFB-3FA90BB1D2DD {
+    SECTION UI = "uefiplat.cfg"
+    SECTION RAW = Platforms/OnePlus/caihongPkg/RawFiles/uefiplat.cfg
+  }
+
+  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
+    #
+    # caihong: the inner volume is stored UNCOMPRESSED.
+    #
+    # Upstream wraps it in a GUIDed LZMA section
+    # (SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED
+    # = TRUE).  On this device PrePi can parse that section but cannot decode
+    # it: ExtractGuidedSectionGetInfo() returns EFI_SUCCESS while
+    # ExtractGuidedSectionDecode() fails with EFI_INVALID_PARAMETER, and
+    # FfsProcessSection() reports both as EFI_NOT_FOUND.  See
+    # docs/bringup-log.md B18/B19 for the panel-probe evidence.
+    #
+    # Storing the volume unwrapped removes the guided-section path entirely:
+    # FfsProcessSection() finds the EFI_SECTION_FIRMWARE_VOLUME_IMAGE directly
+    # and FfsProcessFvFile() just publishes it, with no decoder involved.
+    #
+    # Cost: the volume is ~11 MB instead of ~1.2 MB, so TARGET_FD_BASE/SIZE
+    # moved from 0xA7000000/4 MB to 0xB8000000/12 MB (the front of the ABL
+    # DXE_Heap region); the heap now starts at 0xB8C00000.
+    #
+    SECTION FV_IMAGE = FVMAIN
+  }
+
+  !include SiliciumPkg/Common.fdf.inc
diff --git a/Resources/Configs/caihong.conf b/Resources/Configs/caihong.conf
new file mode 100644
index 0000000..628d5fb
--- /dev/null
+++ b/Resources/Configs/caihong.conf
@@ -0,0 +1,44 @@
+# Build configuration for OnePlus Pad Pro (caihong / OPD2404), SM8650 "Cliffs"
+#
+# Consumed by build_uefi.sh, which sources Resources/Configs/<device>.conf.
+#
+# NOTE ON TARGET_FD_BASE
+# ----------------------
+# When TARGET_REQUIRES_BOOTSHIM=1, BootShim decides where the UEFI firmware
+# volume is relocated to.
+#
+# HISTORY
+#   The ABL reserves 0xA7000000 + 0x400000 for UEFI_FD, and the port originally
+#   used exactly that.  4 MB is only enough while the inner firmware volume is
+#   compressed, and PrePi cannot decompress this platform's volume (the GUIDed
+#   LZMA decode fails -- see docs/bringup-log.md B19).  So the volume is now
+#   built UNCOMPRESSED, which needs ~11 MB.
+#
+# CURRENT CHOICE
+#   0xB8000000 -- the base of the ABL "DXE_Heap" region (0xB8000000 +
+#   0x1BA00000, 452 MB of ordinary DRAM reserved for UEFI).  The firmware takes
+#   the first 12 MB and the DXE heap is moved up to 0xB8C00000; see the "UEFI FD"
+#   and "DXE Heap" entries in
+#   Platforms/OnePlus/caihongPkg/Library/DeviceMemoryMapLib/DeviceMemoryMapLib.c.
+#
+#   This region is NOT where ABL loaded our boot image from (that is the
+#   "Kernel" region at 0xA8000000), so the BootShim copy does not overlap its
+#   own source.
+
+# General Configs
+TARGET_DEVICE_VENDOR="OnePlus"
+TARGET_MULTIPLE_MODELS=0
+TARGET_NUMBER_OF_MODELS=1
+
+# BootShim Configs
+TARGET_REQUIRES_BOOTSHIM=1
+TARGET_FD_BASE=0xBAB00000
+TARGET_FD_SIZE=0x00E00000
+TARGET_FD_BLOCKS=0xE00
+
+# FDT Configs
+# Windows on ARM does not consume a device tree; the firmware describes the
+# hardware through ACPI (see acpi/caihong/ and Silicium-ACPI), so no FDT
+# pointer is created.
+TARGET_CREATE_POINTER=0
+TARGET_POINTER_ADDRESS=0x0
diff --git a/Resources/Scripts/caihong.sh b/Resources/Scripts/caihong.sh
new file mode 100644
index 0000000..e11c96c
--- /dev/null
+++ b/Resources/Scripts/caihong.sh
@@ -0,0 +1,75 @@
+#!/bin/bash
+#
+# Assemble the flashable payload for the OnePlus Pad Pro (caihong / SM8650).
+#
+# Sourced by build_uefi.sh after a successful firmware link:
+#   if [ -f "Resources/Scripts/${TARGET_DEVICE}.sh" ]; then source ...; fi
+#
+# This script ONLY assembles a file.  It never touches the device: no fastboot,
+# no adb, no partition writes.  Flashing is a separate, manual, human-confirmed
+# step documented in docs/recovery.md.
+#
+# What it produces
+#   Mu-caihong-<model>-Model.img   Android boot image (header v1) containing
+#                                  BootShim + the UEFI firmware volume
+#
+# Memory layout
+#   BootShim is prepended so that ABL's normal "boot the kernel" path actually
+#   starts our UEFI.  BootShim relocates itself and jumps to the FD base that
+#   was compiled into it (TARGET_FD_BASE from Resources/Configs/caihong.conf).
+#
+# Deliberate deviation from the other devices: no device tree is appended.
+#   Every other Resources/Scripts/<device>.sh concatenates
+#   ./Resources/DTBs/<device>.dtb.  There is no verified *standalone* board DTB
+#   for caihong: the board description ships as overlay entry index 7 inside
+#   dtbo.img and only merges onto the SoC DTB carried in vendor_boot.img, and
+#   the Linux project delivers its DTB inside its own boot image rather than as
+#   a reusable file.  Appending the SoC-only DTB (work/dt/vendor_boot/vendor.dtb)
+#   would hand ABL a tree with board-id <0 0> instead of <8 0>, so it is not
+#   done here.  On the real device ABL continues to apply the stock dtbo, which
+#   is exactly what the stock boot flow does.
+#   TODO: revisit once a dump of the running device's merged DTB exists.
+
+set -u
+
+BUILD_MODE="${TARGET_BUILD_MODE:-RELEASE}"
+PKG_DIR="./Build/caihongPkg/${BUILD_MODE}_CLANGPDB/FV"
+FD="${PKG_DIR}/CAIHONG_UEFI.fd"
+SHIM="./BootShim/BootShim.bin"
+OUT="Mu-caihong-${TARGET_DEVICE_MODEL:-0}-Model.img"
+
+fail() { echo "caihong.sh: $*" >&2; return 1; }
+
+[ -f "$FD" ]   || { fail "firmware volume not found: $FD"; return 1; }
+[ -f "$SHIM" ] || { fail "BootShim not built: $SHIM"; return 1; }
+[ -s "$SHIM" ] || { fail "BootShim is empty: $SHIM"; return 1; }
+
+echo "== caihong: assembling boot payload"
+echo "   fd     : $FD ($(wc -c < "$FD") bytes)"
+echo "   bootshim: $SHIM ($(wc -c < "$SHIM") bytes)"
+
+cat "$SHIM" "$FD" > "${FD}-bootshim" || { fail "concat failed"; return 1; }
+gzip -c < "${FD}-bootshim" > "${FD}-bootshim.gz" || { fail "gzip failed"; return 1; }
+cp "${FD}-bootshim.gz" ./Resources/bootpayload.bin || { fail "copy failed"; return 1; }
+
+# mkbootimg.py must exist in the checkout; it is part of Resources/Scripts.
+if [ ! -f ./Resources/Scripts/mkbootimg.py ]; then
+	fail "Resources/Scripts/mkbootimg.py missing; cannot package a boot image"
+	return 1
+fi
+[ -f ./Resources/ramdisk ] || { fail "Resources/ramdisk missing"; return 1; }
+
+python3 ./Resources/Scripts/mkbootimg.py \
+  --kernel ./Resources/bootpayload.bin \
+  --ramdisk ./Resources/ramdisk \
+  --kernel_offset 0x00000000 \
+  --ramdisk_offset 0x00000000 \
+  --tags_offset 0x00000000 \
+  --os_version 13.0.0 \
+  --os_patch_level "$(date '+%Y-%m')" \
+  --header_version 1 \
+  -o "$OUT" \
+  || { fail "mkbootimg failed"; return 1; }
+
+echo "== caihong: wrote $OUT ($(wc -c < "$OUT") bytes)"
+echo "== NOT FLASHED. Read docs/recovery.md before doing anything with this file."
diff --git a/Silicon/Qualcomm/CliffsPkg/CliffsPkg.dsc.inc b/Silicon/Qualcomm/CliffsPkg/CliffsPkg.dsc.inc
new file mode 100644
index 0000000..3d9e785
--- /dev/null
+++ b/Silicon/Qualcomm/CliffsPkg/CliffsPkg.dsc.inc
@@ -0,0 +1,132 @@
+##
+#  Copyright (c) 2011 - 2022, ARM Limited. All rights reserved.
+#  Copyright (c) 2014, Linaro Limited. All rights reserved.
+#  Copyright (c) 2015 - 2020, Intel Corporation. All rights reserved.
+#  Copyright (c) 2018, Bingxing Wang. All rights reserved.
+#  Copyright (c) Microsoft Corporation.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+#  Qualcomm SM8650 ("Cliffs") SoC package - OnePlus Pad Pro (caihong) port.
+#
+#  Derived from KailuaPkg.dsc.inc (SM8550, "Snapdragon 8 Gen 2").  Every value
+#  that was changed is annotated with the evidence that justifies it; values
+#  that could not be verified from this device's firmware are left inherited
+#  and explicitly flagged with TODO.
+#
+#  EVIDENCE BASE
+#  -------------
+#  Device: OnePlus Pad Pro (caihong / OPD2404), SM8650.
+#  Sources: dtbo.img (active entry index 7) and the vendor_boot.img vendor DTB,
+#  both extracted with scripts/extract_dtb.py.  Reproduce with
+#  scripts/extract_hw.py.
+#
+#  SM8550 vs SM8650 - what is actually identical (independently verified)
+#    GIC distributor      0x17100000   (SM8650 vendor DTB intc@17100000)
+#    GIC redistributor    0x17180000   (size 0x200000 in the SM8650 DTB)
+#    Arch timer frequency 19200000 Hz  (SM8650 DTB timer clock-frequency)
+#    Timer GSIVs          29 / 30      (SM8650 DTB PPIs 13/14 => 16 + PPI)
+#    CPU count / clusters 8 / 3        (SM8650 DTB qcom,cpuidle-domain map)
+#  scripts/build_soc_acpi.py hard-asserts these before deriving the SM8650
+#  ACPI tables, so a future upstream change cannot silently invalidate them.
+##
+
+[Defines]
+  # GIC
+  USE_CUSTOM_GIC                             = 0
+
+  # Timer
+  USE_CUSTOM_TIMER                           = 0
+  USE_PHYSICAL_TIMER                         = 0
+
+  # KEP (Kernel Errata Patcher, ArmPkg)
+  ENABLE_KEP                                 = 1
+  HAS_ACTLR_EL1_UNIMPLEMENTED_ERRATA         = 1
+  HAS_AMCNTENSET0_EL0_UNIMPLEMENTED_ERRATA   = 1
+  HAS_GIC_V3_WITHOUT_IRM_FLAG_SUPPORT_ERRATA = 1
+  HAS_PSCI_MEMPROTECT_FAILING_ERRATA         = 0
+
+[BuildOptions]
+  # SM8650 cores are ARMv9.2-A (Cortex-X4 / Cortex-A720 / Cortex-A520).
+  # armv9-a+crypto+rcpc is the conservative subset used by the SM8550 package
+  # and is accepted by all three core types; deliberately not raised to
+  # armv9.2-a until boot has been proven on hardware.
+  *_*_AARCH64_CC_FLAGS = -march=armv9-a+crypto+rcpc
+
+[PcdsFixedAtBuild]
+  # Platform Pei HOBs
+  gQcomPkgTokenSpaceGuid.PcdEnableInfoBlkHob|TRUE
+  gQcomPkgTokenSpaceGuid.PcdEnableShimHob|TRUE
+  gQcomPkgTokenSpaceGuid.PcdEnableProdmodeHob|TRUE
+
+  # ---------------------------------------------------------------------------
+  # FV decompress address = the ABL's "FV_Region".
+  #
+  # RECOVERED FROM THE DEVICE, not guessed: xbl_config.img contains an XBL
+  # memory-region table (41 entries, see docs/abl-memory-map.json) in which
+  # FV_Region = 0xA7AD9000, size 0x400000 (4 MB).  PlatformHobLib publishes
+  # this as gFvDecompressHobGuid when non-zero.
+  #
+  # CAVEAT: it is an *inference* that "FV_Region" is what this PCD means.
+  # The upstream SM8550 package sets 0xA703A0C8, which lies inside its
+  # UEFI_FD region rather than in its FV region, so the two ports may be
+  # interpreting the PCD differently.  If DxeCore reports
+  # "Dxe Core FV decompression failed" on hardware, this is the first value to
+  # revisit.  Tracked in docs/bringup-log.md B11.2.
+  # ---------------------------------------------------------------------------
+  gQcomPkgTokenSpaceGuid.PcdFvDecompressAddr|0xA7AD9000
+
+  # CPU.  8 cores in 3 clusters: the SM8650 vendor DTB's
+  # qcom,cpuidle-domain cpu-map declares cluster sizes 3 / 4 / 1.
+  gArmPlatformTokenSpaceGuid.PcdCoreCount|8
+  gArmPlatformTokenSpaceGuid.PcdClusterCount|3
+
+  # GICv3.  Distributor 0x17100000 and redistributor 0x17180000 come directly
+  # from the SM8650 vendor DTB interrupt-controller node.
+  # PcdGicInterruptInterfaceBase is consumed only by the GICv2 driver; for
+  # GICv3 system-register mode it is inert, so it is kept at the SM8550 value
+  # rather than invented.
+  gArmTokenSpaceGuid.PcdGicDistributorBase|0x17100000
+  gArmTokenSpaceGuid.PcdGicRedistributorsBase|0x17180000
+  gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase|0x17140000
+
+  # Timer.  19200000 Hz and GSIV 29/30 read from the SM8650 vendor DTB
+  # (timer clock-frequency; PPIs 13 and 14).
+  gArmTokenSpaceGuid.PcdArmArchTimerFreqInHz|19200000
+  gArmTokenSpaceGuid.PcdArmArchTimerSecIntrNum|29
+  gArmTokenSpaceGuid.PcdArmArchTimerIntrNum|30
+
+  # SmBios
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosProcessorModel|"Snapdragon (TM) 8 Gen 3"
+  # caihong reports ro.board.platform=pineapple and 8 cores.
+!if $(SOC_TYPE) == 0
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosProcessorPartNumber|"SM8650-AB"
+!elseif $(SOC_TYPE) == 1
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosProcessorPartNumber|"SM8650-AC"
+!endif
+
+  # SmBios CPU Extras
+  # 3302 MHz comes from the caihong Linux project documentation, which states
+  # the 3.3024 GHz boost clock and that it is disabled by default.
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosMaxCpuFreq|3302
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosLevel1InstCacheSize|0x40
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosLevel1DataCacheSize|0x40
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosLevel2CacheSize|0x400
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosLevel3CacheSize|0x2000   # TODO unverified
+
+  # SmBios Memory Extras
+  # TODO unverified for this device.  The SM8650 reference platform uses
+  # LPDDR5X; the populated speed on caihong is not known from any source
+  # available here.  Cosmetic only (SMBIOS type 17), does not affect boot.
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosMemorySpeed|8533
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosMemoryType|35
+
+[LibraryClasses]
+  PlatformPrePiLib|CliffsPkg/Library/PlatformPrePiLib/PlatformPrePiLib.inf
+  RFSProtectionLib|CliffsPkg/Library/RFSProtectionLib/RFSProtectionLib.inf
+  AcpiPlatformUpdateLib|CliffsPkg/Library/AcpiPlatformUpdateLib/AcpiPlatformUpdateLib.inf
+  HwResetSystemLib|ArmPkg/Library/ArmSmcPsciResetSystemLib/ArmSmcPsciResetSystemLib.inf
+  ResetSystemLib|ArmPkg/Library/ArmSmcPsciResetSystemLib/ArmSmcPsciResetSystemLib.inf
+  SoCPlatformLib|CliffsPkg/Library/SoCPlatformLib/SoCPlatformLib.inf
+
+!include QcomPkg/QcomPkg.dsc.inc
diff --git a/Silicon/Qualcomm/CliffsPkg/Library/AcpiPlatformUpdateLib/AcpiPlatformUpdateLib.c b/Silicon/Qualcomm/CliffsPkg/Library/AcpiPlatformUpdateLib/AcpiPlatformUpdateLib.c
new file mode 100644
index 0000000..e02321c
--- /dev/null
+++ b/Silicon/Qualcomm/CliffsPkg/Library/AcpiPlatformUpdateLib/AcpiPlatformUpdateLib.c
@@ -0,0 +1,118 @@
+#include <Library/AslUpdateLib.h>
+#include <Library/MemoryMapHelperLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/RFSProtectionLib.h>
+
+#include <Protocol/EFIChipInfo.h>
+#include <Protocol/EFIPlatformInfo.h>
+#include <Protocol/EFISmem.h>
+
+VOID
+PlatformUpdateAcpiTables ()
+{
+  EFI_STATUS                          Status;
+  ARM_MEMORY_REGION_DESCRIPTOR_EX     MPSSEFSRegion;
+  ARM_MEMORY_REGION_DESCRIPTOR_EX     ADSPEFSRegion;
+  EFI_CHIPINFO_PROTOCOL              *mChipInfoProtocol;
+  EFI_PLATFORMINFO_PROTOCOL          *mPlatformInfoProtocol;
+  EFI_SMEM_PROTOCOL                  *mSmemProtocol;
+  EFI_PLATFORMINFO_PLATFORM_INFO_TYPE PlatformInfo;
+
+  UINT32 SOID                            = 0;
+  UINT32 STOR                            = 0x1;
+  UINT32 SIDV                            = 0;
+  UINT16 SDFE                            = 0;
+  UINT16 SIDM                            = 0;
+  UINT32 SUFS                            = 0xFFFFFFFF;
+  UINT32 PUS3                            = 0x1;
+  UINT32 SUS3                            = 0xFFFFFFFF;
+  UINT32 SOSN1                           = 0;
+  UINT32 SOSN2                           = 0;
+  UINT32 TPMA                            = 0x1;
+  UINT32 TDTV                            = 0x6654504D;
+  UINT64 SOSI                            = 0;
+  UINT32 PRP0                            = 0;
+  UINT32 PRP1                            = 0;
+  CHAR8  SIDS[EFICHIPINFO_MAX_ID_LENGTH] = {0};
+  UINT32 RMTB                            = 0;
+  UINT32 RMTX                            = 0;
+  UINT32 RFMB                            = 0;
+  UINT32 RFMS                            = 0;
+  UINT32 RFAB                            = 0;
+  UINT32 RFAS                            = 0;
+  UINT32 TCMA                            = 0;
+  UINT32 TCML                            = 0;
+  UINT32 SmemSize                        = 0;
+
+  // Locate Chip Info Protocol
+  Status  = gBS->LocateProtocol (&gEfiChipInfoProtocolGuid, NULL, (VOID *)&mChipInfoProtocol);
+
+  // Locate SMEM Protocol
+  Status |= gBS->LocateProtocol (&gEfiSMEMProtocolGuid, NULL, (VOID *)&mSmemProtocol);
+
+  // Locate Platform Info Protocol
+  Status |= gBS->LocateProtocol (&gEfiPlatformInfoProtocolGuid, NULL, (VOID *)&mPlatformInfoProtocol);
+
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  mChipInfoProtocol->GetChipId       (mChipInfoProtocol, (EFIChipInfoIdType *)&SOID);
+  mChipInfoProtocol->GetChipVersion  (mChipInfoProtocol, &SIDV);
+  mChipInfoProtocol->GetChipFamily   (mChipInfoProtocol, (EFIChipInfoFamilyType *)&SDFE);
+  mChipInfoProtocol->GetModemSupport (mChipInfoProtocol, (EFIChipInfoModemType *)&SIDM);
+  mChipInfoProtocol->GetSerialNumber (mChipInfoProtocol, (EFIChipInfoSerialNumType *)&SOSN1);
+  mChipInfoProtocol->GetQFPROMChipId (mChipInfoProtocol, (EFIChipInfoQFPROMChipIdType *)&SOSN2);
+  mChipInfoProtocol->GetChipIdString (mChipInfoProtocol, SIDS, EFICHIPINFO_MAX_ID_LENGTH);
+
+  mSmemProtocol->GetFunc (137, &SmemSize, (VOID *)&SOSI);
+
+  mPlatformInfoProtocol->GetPlatformInfo (mPlatformInfoProtocol, &PlatformInfo);
+
+  UINT16 SVMJ = (UINT16)((SIDV >> 16) & 0xFFFF);
+  UINT16 SVMI = (UINT16)(SIDV & 0xFFFF);
+  UINT64 SOSN = ((UINT64)SOSN2 << 32) | SOSN1;
+  UINT32 PLST = PlatformInfo.subtype;
+
+  if (!EFI_ERROR (LocateMemoryMapAreaByName ("MPSS_EFS", &MPSSEFSRegion))) {
+    RMTB = MPSSEFSRegion.Address;
+    RMTX = MPSSEFSRegion.Length;
+
+    // Configure MPSS Permissions
+    RFSLocateAndProtectSharedArea ();
+  }
+
+  if (!EFI_ERROR (LocateMemoryMapAreaByName ("ADSP_EFS", &ADSPEFSRegion))) {
+    RFMB = (UINT32)ADSPEFSRegion.Address + (UINT32)ADSPEFSRegion.Length / 2;
+    RFMS = (UINT32)ADSPEFSRegion.Length / 2;
+    RFAB = (UINT32)ADSPEFSRegion.Address;
+    RFAS = (UINT32)ADSPEFSRegion.Length / 2;
+  }
+
+  UpdateNameAslCode (SIGNATURE_32('S', 'O', 'I', 'D'), &SOID, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'T', 'O', 'R'), &STOR, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'I', 'D', 'V'), &SIDV, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'V', 'M', 'J'), &SVMJ, 2);
+  UpdateNameAslCode (SIGNATURE_32('S', 'V', 'M', 'I'), &SVMI, 2);
+  UpdateNameAslCode (SIGNATURE_32('S', 'D', 'F', 'E'), &SDFE, 2);
+  UpdateNameAslCode (SIGNATURE_32('S', 'I', 'D', 'M'), &SIDM, 2);
+  UpdateNameAslCode (SIGNATURE_32('S', 'U', 'F', 'S'), &SUFS, 4);
+  UpdateNameAslCode (SIGNATURE_32('P', 'U', 'S', '3'), &PUS3, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'U', 'S', '3'), &SUS3, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'O', 'S', 'N'), &SOSN, 8);
+  UpdateNameAslCode (SIGNATURE_32('P', 'L', 'S', 'T'), &PLST, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'M', 'T', 'B'), &RMTB, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'M', 'T', 'X'), &RMTX, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'F', 'M', 'B'), &RFMB, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'F', 'M', 'S'), &RFMS, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'F', 'A', 'B'), &RFAB, 4);
+  UpdateNameAslCode (SIGNATURE_32('R', 'F', 'A', 'S'), &RFAS, 4);
+  UpdateNameAslCode (SIGNATURE_32('T', 'P', 'M', 'A'), &TPMA, 4);
+  UpdateNameAslCode (SIGNATURE_32('T', 'D', 'T', 'V'), &TDTV, 4);
+  UpdateNameAslCode (SIGNATURE_32('T', 'C', 'M', 'A'), &TCMA, 4);
+  UpdateNameAslCode (SIGNATURE_32('T', 'C', 'M', 'L'), &TCML, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'O', 'S', 'I'), &SOSI, 8);
+  UpdateNameAslCode (SIGNATURE_32('P', 'R', 'P', '0'), &PRP0, 4);
+  UpdateNameAslCode (SIGNATURE_32('P', 'R', 'P', '1'), &PRP1, 4);
+  UpdateNameAslCode (SIGNATURE_32('S', 'I', 'D', 'S'), &SIDS, EFICHIPINFO_MAX_ID_LENGTH);
+}
